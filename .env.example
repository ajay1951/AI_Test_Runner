# Optional Groq API Key (If omitted, system uses deterministic heuristic fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
PLANNER_MODE=hybrid
PLANNER_STRICT=false
HEADLESS=false
TIMEOUT_MS=15000

# Secure Test Credentials (Used by macro-planner for authentication workflows)
TEST_CUSTOMER_EMAIL=user@phptravels.com
TEST_CUSTOMER_PASSWORD=demouser
TEST_ADMIN_EMAIL=admin@phptravels.com
TEST_ADMIN_PASSWORD=demoadmin
